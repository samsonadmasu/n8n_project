    {
      "name": "check_availability",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        2060,
        560
      ],
      "parameters": {
        "toolDescription": "Get the free appointment start times at Northgate Physio for one date. Call before offering any times.",
        "method": "POST",
        "url": "https://YOUR-N8N-INSTANCE.app.n8n.cloud/webhook/northgate-tools/check-availability",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $fromAI('date', 'The date in YYYY-MM-DD format', 'string'), therapist: $fromAI('therapist', 'Amina, Daniel or Sara. Empty string when the caller has no preference', 'string', '') }) }}",
        "options": {
          "timeout": 8000
        }
      }
    },
    {
      "name": "create_booking",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        2180,
        560
      ],
      "parameters": {
        "toolDescription": "Book an appointment. Needs the date, a free time, the caller's full name and phone number.",
        "method": "POST",
        "url": "https://YOUR-N8N-INSTANCE.app.n8n.cloud/webhook/northgate-tools/create-booking",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $fromAI('date', 'The date in YYYY-MM-DD format', 'string'), time: $fromAI('time', 'Start time in 24-hour HH:MM', 'string'), therapist: $fromAI('therapist', 'Amina, Daniel or Sara. Empty string when the caller has no preference', 'string', ''), patientName: $fromAI('patientName', 'The caller full name', 'string'), phone: $fromAI('phone', 'The caller phone number, digits with optional leading +', 'string'), source: 'voice-loop' }) }}",
        "options": {
          "timeout": 8000
        }
      }
    },
    {
      "name": "cancel_booking",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        2300,
        560
      ],
      "parameters": {
        "toolDescription": "Cancel the caller's appointment. Needs their phone number and the date; add the time if they have more than one booking that day.",
        "method": "POST",
        "url": "https://YOUR-N8N-INSTANCE.app.n8n.cloud/webhook/northgate-tools/cancel-booking",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $fromAI('phone', 'The caller phone number, digits with optional leading +', 'string'), date: $fromAI('date', 'The date of the appointment in YYYY-MM-DD format', 'string'), time: $fromAI('time', 'Start time in 24-hour HH:MM, or empty string if not known', 'string', '') }) }}",
        "options": {
          "timeout": 8000
        }
      }
    },
    {
      "name": "clinic_faq",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        2420,
        560
      ],
      "parameters": {
        "description": "Facts about Northgate Physio: opening hours, therapists, appointment length, booking window, what to bring, cancellation notice, prices.",
        "language": "javaScript",
        "jsCode": "// clinic_faq tool. The agent calls this for any question about the clinic.\n// Only facts listed here may be told to callers. Anything else: staff call back.\nreturn [\n  'Opening hours: Monday to Friday 9 a.m. to 5 p.m., last appointment starts at 4 p.m. Saturday 9 a.m. to 1 p.m., last appointment starts at 12 noon. Closed on Sunday.',\n  'Therapists: Amina, Daniel and Sara.',\n  'Appointments last 45 minutes and start on the hour.',\n  'Bookings can be made from tomorrow up to 30 days ahead, by phone or with this assistant.',\n  'Please bring comfortable clothes you can move in, and any scans or referral letters.',\n  'Please give at least 24 hours notice to cancel or move an appointment.',\n  'Prices, insurance and anything not listed here: a member of staff will call the caller back.',\n].join('\\n');\n"
      }
    },
