    {
      "name": "Check for emergencies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Guardrail: runs BEFORE the AI agent. Anything that sounds like an emergency gets a fixed,\n// reviewed safety script. The LLM never improvises on these.\nconst URGENT = [\n  /chest pain/i, /heart attack/i, /stroke/i,\n  /can'?t breathe|cannot breathe|trouble breathing|difficulty breathing|short(ness)? of breath|struggling to breathe/i,\n  /unconscious|passed out|fainted|not responding/i,\n  /heavy bleeding|bleeding (a lot|heavily|badly)|won'?t stop bleeding/i,\n  /hit (my|his|her|their) head|head injury|fell .*head/i,\n  /suicid|kill myself|overdose/i,\n];\nconst callerText = String($input.first().json.callerText || '').trim();\nconst matched = URGENT.find(r => r.test(callerText));\nreturn [{ json: { callerText, urgent: Boolean(matched), matched: matched ? String(matched) : '' } }];\n"
      },
      "notes": "Fixed safety script for emergencies. The LLM never sees these."
    },
    {
      "name": "Emergency?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Emergency?",
              "leftValue": "={{ $json.urgent }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Safety script",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1760,
        60
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "Safety script-reply",
              "name": "reply",
              "type": "string",
              "value": "This sounds like it could be an emergency. Please hang up now and call your local emergency number. If you can't, ask someone near you to call for you."
            },
            {
              "id": "Safety script-route",
              "name": "route",
              "type": "string",
              "value": "urgent"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Receptionist prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "Receptionist prompt-systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "=You are the voice receptionist for Northgate Physio, a physiotherapy clinic. Today is {{ $now.setZone('Africa/Addis_Ababa').toFormat('cccc d LLLL yyyy') }} ({{ $now.setZone('Africa/Addis_Ababa').toISODate() }}). The clinic's time zone is Africa/Addis_Ababa.\n\nYour reply is spoken aloud. Use at most three short sentences, plain words, no lists, no markdown, no emoji. Say times like \"two p.m.\" and dates like \"Wednesday the second of December\".\n\nFacts: use the clinic_faq tool for any question about the clinic, such as opening hours, therapists, what to bring or cancellation notice. Never invent facts. If clinic_faq doesn't cover it, say a member of staff will call back.\n\nBooking:\n- Work out dates as YYYY-MM-DD from today's date.\n- Call check_availability before offering times, and offer at most three.\n- create_booking needs the date, the time in 24-hour HH:MM, the caller's full name and phone number. If the caller has already given all of these clearly, book straight away. Otherwise ask only for what is missing.\n- Only say an appointment is booked if create_booking returns booked true. Then give the therapist, day, time and reference.\n\nCancelling:\n- cancel_booking needs the caller's phone number and the date, plus the time if they have more than one booking that day. Use what the caller already told you earlier in the conversation.\n- Only say it is cancelled if cancel_booking returns cancelled true.\n\nIf a tool returns booked false or cancelled false, explain its message briefly and offer what it suggests.\nNever give medical advice and never ask about symptoms or medical history. Only collect name and phone number.\n"
            },
            {
              "id": "Receptionist prompt-callerText",
              "name": "callerText",
              "type": "string",
              "value": "={{ $json.callerText }}"
            }
          ]
        },
        "options": {}
      }
    },
