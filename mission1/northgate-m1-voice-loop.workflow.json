{
  "name": "Northgate · M1 Voice Loop",
  "settings": { "executionOrder": "v1", "binaryMode": "separate" },
  "nodes": [
    {
      "name": "Voice request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 300],
      "webhookId": "333f6c8b-dba0-43d1-9dab-dd47fcc3b03d",
      "parameters": {
        "httpMethod": "POST",
        "path": "northgate-voice",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      }
    },
    {
      "name": "Validate recording",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "notes": "Rejects missing, empty, oversized or non-audio uploads before we spend money on ElevenLabs or the LLM.",
      "parameters": {
        "jsCode": "// Cheap checks first: every rejected request here costs nothing downstream.\nconst MAX_BYTES = 5 * 1024 * 1024;   // ~5 minutes of speech\nconst MIN_BYTES = 1000;              // shorter than this is silence or a broken recording\nconst ALLOWED = ['audio/webm', 'video/webm', 'audio/mp4', 'audio/x-m4a', 'audio/m4a', 'audio/aac', 'audio/ogg', 'audio/mpeg', 'audio/wav', 'audio/x-wav'];\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst requestId = String(headers['x-request-id'] || $execution.id).slice(0, 80);\nconst base = { requestId, startedAt: Date.now() };\nconst reject = (error, extra = {}) => [{ json: { ...base, ok: false, status: 400, error, ...extra } }];\n\nconst bin = item.binary && item.binary.audio;\nif (!bin) return reject('No recording received. Send it as a form field named \"audio\".');\n\nconst mimeType = (bin.mimeType || '').split(';')[0].trim().toLowerCase();\nconst bytes = (await this.helpers.getBinaryDataBuffer(0, 'audio')).length;\n\nif (bytes < MIN_BYTES) return reject(`The recording is empty or too short (${bytes} bytes). Speak for at least a second.`, { bytes, mimeType });\nif (bytes > MAX_BYTES) return reject(`The recording is ${(bytes / 1048576).toFixed(1)} MB. The limit is 5 MB.`, { bytes, mimeType });\nif (!ALLOWED.includes(mimeType)) return reject(`Audio type \"${mimeType || 'unknown'}\" isn't supported. Send webm, mp4/m4a, ogg, mp3 or wav.`, { bytes, mimeType });\n\nreturn [{ json: { ...base, ok: true, bytes, mimeType }, binary: item.binary }];"
      }
    },
    {
      "name": "Recording OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 300],
      "parameters": {
